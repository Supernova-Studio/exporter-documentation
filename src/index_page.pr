<!-- Redirect to the first real page -->
{[ let rootGroup = ds.rootDocumentationGroup() /]}
{[ let page = firstPageFromTop(rootGroup) /]}
{[ let url = pageUrl(page, ds.documentationDomain()) /]}

{[ if (!page) ]}
  {[ let isLive = (ds.documentationEnvironment() === "Live") /]}
  {[ if isLive ]}
    {{ throwError("The current page selection contains no visible pages. Make sure at least one page is included and visible before publishing.") }}
  {[ else ]}
    {{ throwError("The current page selection contains no visible pages. Make sure at least one page is included and visible before building the preview.") }}
  {[/]}
{[/]}

<!DOCTYPE HTML>
 
<meta charset="UTF-8">
<meta http-equiv="refresh" content="1; url={{ url }}">
{* SEO *}
{[ inject "page_seo" context page /]}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 
<script>
  window.location.href = "{{ url }}"
</script>
