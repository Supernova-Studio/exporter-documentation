{[ const block = context /]}

{[ let variant = block.variantKey /]}

{* Render markdown block from configuration *}
{[ let url = block.properties.markdownUrl /]}

{[ if isNonEmptyString(url) ]}
    {* Fetch the markdown content stored for this URL through the Supernova backend *}
    {[ let markdownData = ds.markdownFromUrl(url) /]}
    {[ if isNonEmptyString(markdownData.content) ]}
        {* Render converted markdown. We use showdown markdown engine with github extension to convert the data *}
        <div class="content-block content-block--markdown{{ getVariantClass(variant) }}">
            {{ markdownToHTML(markdownData.content) }}
        </div>
    {[ else ]}
        {* Markdown download failed *}
        <p lang="en">Unable to render Markdown block with url {{ url }}, might not be Markdown definition or is unreachable. If Markdown is private, please configure a Git integration for your workspace first.</p>
    {[/]}
{[ else ]}
<p lang="en">Unable to render Markdown block, please provide valid <mark>.md</mark> URL.</p>
{[/]}
