{* Get embed block payload *}
{[ const block = context /]}
{[ let imgClass = "img-fluid" /]}
{[ let alignClass = "sn-text-left" /]}

{[ if block.url ]}
    {[ if block.alignment ]}
        {[ switch block.alignment ]}
            {[ case "Left" ]}
                {[ imgClass = "img-fluid" /]}
                {[ alignClass = "sn-text-left" /]}
            {[ case "Center" ]}
                {[ imgClass = "img-fluid" /]}
                {[ alignClass = "sn-text-center" /]}
            {[ case "Stretch" ]}
                {[ imgClass = "img-fluid max" /]}
                {[ alignClass = "sn-text-center" /]}
        {[/]}
    {[/]}

    <div class="content-block content-block--shortcuts variant-image-leading-1">
        <a href="{{ block.url }}" class="shortcut-item" {{ (block.openInNewTab || block.openInNewTab === undefined) ? "target=\"_blank\"" : ""}}>
            {[ if block.thumbnailUrl ]}
                <div class="preview {{ alignClass }}">
                    <img src="{{ block.thumbnailUrl }}" class="{{ imgClass }}" alt="" />
                </div>
            {[ else ]}
                <div class="preview empty"></div>
            {[/]}
            <div class="content">
                {[ if block.title ]}
                    <p class="title">{{ escapeHtmlWithNewlines(block.title) }}</p>
                {[/]}
                
                {[ if (block.description) ]}
                    <p class="description">{{ escapeHtmlWithNewlines(block.description) }}</p>    
                {[/]}

                <p class="link">{{ escapeHtml(block.url) }}</p>    
            </div>
        </a>
    </div>
{[/]}
