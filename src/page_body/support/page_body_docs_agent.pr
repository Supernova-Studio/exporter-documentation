{* Docs agent POC: the header's "Ask AI" button opens the chat from the local docs agent in a side panel *}

<!-- Docs agent (POC) -->
<style>
    .docs-agent-toggle {
        width: auto;
        padding: 0 10px;
        font-weight: 600;
        white-space: nowrap;
    }
    /* Sits below the header, so its "Ask AI" button stays visible to close the panel */
    .docs-agent-panel {
        position: fixed;
        top: var(--topNavHeight, 0px);
        right: 0;
        bottom: 0;
        z-index: 1050;
        width: min(420px, 100vw);
        background: #fff;
        border-left: 1px solid rgb(9 18 42 / 0.1);
        box-shadow: 0 15px 25px rgb(9 18 42 / 0.07);
    }
    .docs-agent-panel[hidden] { display: none; }
    .docs-agent-panel iframe { width: 100%; height: 100%; border: 0; }
</style>
<aside class="docs-agent-panel" id="docs-agent-panel" aria-label="Documentation assistant" hidden></aside>
<script>
    (function () {
        // POC: a local export has no published address, so the chat gets a fixed page to answer from
        var chatUrl = "http://localhost:2001/embed?workspaceId=3764&designSystemId=123825&docsUrl=https%3A%2F%2Fspecial-prawn-green.docs.matejbobek.sst.supernova.io%2Flatest";
        var openKey = "supernova.docsAgent.isOpen";
        var toggle = document.getElementById("docs-agent-toggle");
        var panel = document.getElementById("docs-agent-panel");
        var frame = null;
        if (!toggle || !panel) return;

        function setOpen(isOpen) {
            // The chat loads on first open, so pages that never use it do not pay for it
            if (isOpen && !frame) {
                frame = document.createElement("iframe");
                frame.title = "Documentation assistant";
                frame.allow = "clipboard-write";
                frame.src = chatUrl;
                panel.appendChild(frame);
            }
            panel.hidden = !isOpen;
            toggle.setAttribute("aria-expanded", String(isOpen));
            try { sessionStorage.setItem(openKey, isOpen ? "1" : "0"); } catch (error) {}
        }

        toggle.addEventListener("click", function () { setOpen(panel.hidden); });
        // The chat's own close button asks the page to hide the panel
        window.addEventListener("message", function (event) {
            if (!frame || event.source !== frame.contentWindow) return;
            var data = event.data;
            if (data && data.source === "supernova-docs-agent" && data.type === "close") setOpen(false);
        });

        // Keeps the chat open when the reader follows a link to another page
        try { if (sessionStorage.getItem(openKey) === "1") setOpen(true); } catch (error) {}
    })();
</script>
