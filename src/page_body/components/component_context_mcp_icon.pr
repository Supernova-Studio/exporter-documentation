{[ const icon = context /]}

{[ switch icon ]}
{[ case "cursor" ]}
{[ inject "icon_cursor" context context /]}
{[ case "vs-code" ]}
{[ inject "icon_vs_code" context context /]}
{[ case "claude" ]}
{[ inject "icon_claude" context context /]}
{[ case "codex" ]}
{[ inject "icon_codex" context context /]}
{[ case "code" ]}
{[ inject "icon_code" context context /]}
{[ case "copy" ]}
{[ inject "icon_copy" context context /]}
{[/]}
